# Drishti Nepal - Production Cron Schedule
# Install: crontab < infra/crontab
# All times in UTC (Nepal is UTC+5:45)

# ---- Agent Scheduler (preferred: use systemd service instead) ----
# If not using systemd, uncomment individual cron jobs below:

# News scraper: every 30 min
# */30 * * * * cd /opt/drishtinepal && /opt/drishtinepal/venv/bin/python -m agents.news_scraper.scraper >> /var/log/drishtinepal/news_scraper.log 2>&1

# Content generator: every hour
# 15 * * * * cd /opt/drishtinepal && /opt/drishtinepal/venv/bin/python -m agents.content_generator.generator >> /var/log/drishtinepal/content_generator.log 2>&1

# Social publisher: every 2 hours
# 30 */2 * * * cd /opt/drishtinepal && /opt/drishtinepal/venv/bin/python -m agents.social_publisher.publisher >> /var/log/drishtinepal/social_publisher.log 2>&1

# Manifesto matcher: every 12 hours
# 0 6,18 * * * cd /opt/drishtinepal && /opt/drishtinepal/venv/bin/python -m agents.manifesto_matcher.matcher >> /var/log/drishtinepal/manifesto_matcher.log 2>&1

# Scoring agent: daily at midnight NPT (18:15 UTC)
# 15 18 * * * cd /opt/drishtinepal && /opt/drishtinepal/venv/bin/python -m agents.scoring_agent.scorer >> /var/log/drishtinepal/scoring_agent.log 2>&1

# Cleanup old logs: weekly
0 0 * * 0 find /var/log/drishtinepal/ -name "*.log" -mtime +30 -delete
