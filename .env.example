# Drishti Nepal Agent Configuration

# ----- Supabase -----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ----- AI Providers -----
# NVIDIA NIM (free tier) — primary; get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=qwen/qwen3-235b-a22b
# Optional: split cheap/quality across different models
# NVIDIA_MODEL_CHEAP=qwen/qwen3-235b-a22b
# NVIDIA_MODEL_QUALITY=qwen/qwen3-235b-a22b

# Anthropic (fallback — only needed if NVIDIA_API_KEY is unset)
ANTHROPIC_API_KEY=sk-ant-xxx

# Model selection (used only when falling back to Anthropic)
AI_MODEL_CHEAP=claude-3-5-haiku-20241022
AI_MODEL_QUALITY=claude-sonnet-4-20250514

# ----- Social Media -----
# X (Twitter) - @DrishtiNepalHQ
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# Instagram - @drishtinepal_hq
IG_ACCESS_TOKEN=

# Facebook - facebook.com/DrishtiNepalHQ (pending)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ----- Scraping -----
SCRAPER_USER_AGENT=DrishtiNepal/1.0 (https://drishtinepal.com; contact@drishtinepal.com)

# ----- App -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://drishtinepal.com
NEXT_PUBLIC_BASE_URL=https://drishtinepal.com

# Umami analytics (optional — privacy-friendly, no cookies)
# Create a free account at umami.is, add your site, copy the website ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# ----- Misc -----
ENVIRONMENT=development
LOG_LEVEL=INFO
